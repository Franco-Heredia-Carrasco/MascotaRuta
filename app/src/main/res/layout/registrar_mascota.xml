<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="456dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.216">


        <EditText
            android:id="@+id/texto_mascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Agregue El nombre de la mascota"
            android:text=""
            android:textSize="23sp"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="55dp" />


        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/btn_perro"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:text="Perro"
                android:textSize="24sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/btn_gato"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:text="Gato"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RadioGroup>

        <Switch
            android:id="@+id/sw_sarrampion"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:text="Sarrampion"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <Switch
            android:id="@+id/sw_Sarna"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:text="Sarna"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <CheckBox
            android:id="@+id/vacunas"
            android:layout_width="114dp"
            android:layout_height="53dp"
            android:text="Vacunas al dia"
            tools:layout_editor_absoluteX="11dp"
            tools:layout_editor_absoluteY="422dp" />

        <CheckBox
            android:id="@+id/peso_ideal"
            android:layout_width="114dp"
            android:layout_height="53dp"
            android:text="Peso Ideal" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>